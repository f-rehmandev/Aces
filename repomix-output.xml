def test_exclude_patterns_block_links():
    fetcher = FakeFetcher({
        "https://x.com/a": "<html>a</html>",
        "https://x.com/private/x": "<html>p</html>",
    })
    processor = make_processor(links_by_url={
        "https://x.com/a": ["https://x.com/private/x"],
