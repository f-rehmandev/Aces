        allowed=False,
        client_id="acme",
        resource="page",
        requested=100,
        limit=500,
        consumed=450,
        remaining=50,
        policy="block",
        reason="over limit",
    )
    out = d.to_dict()
    assert out["allowed"] is False
    assert out["remaining"] == 50
