    assert "zscore" in r.summary()


def test_has_critical_flag():
    r = AnomalyDetector().detect(
        [{"title": "SAME"} for _ in range(5)],
        [{"title": f"item-{i}"} for i in range(10)],
    )
    assert r.has_critical
