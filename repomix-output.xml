    assert restored.task_id == "task-42"
    assert restored.task_version == 7
    assert restored.client_id == "acme"
    assert restored.input_manifest == original.input_manifest
    assert [c.urls for c in restored.chunks] == [
        ["a", "b"],
        ["c"],
    ]


