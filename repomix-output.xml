# ---------------------------------------------------------------------------

def test_walk_simple_dict():
    assert _walk_jsonld({"name": "A"}, "name") == "A"


def test_walk_nested():
    assert _walk_jsonld({"offers": {"price": "10"}}, "offers.price") == "10"


def test_walk_missing_returns_none():
