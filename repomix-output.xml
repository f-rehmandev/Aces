    )
    _run(slos.save_slo(slo))
    _run(slos.record_samples(_samples(slo.slo_id, [0.20, 0.20])))
    ev = _run(slos.evaluate(slo))
    assert ev.status == SLOStatus.BREACHED


def test_slo_evaluate_disabled(slos):
