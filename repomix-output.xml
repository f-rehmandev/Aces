def test_fallback_skipped_when_provider_unconfigured():
    scraper = FakeScraper("Please enable JavaScript")
    provider = FakeProvider(configured=False)
    m = NetworkManager(scraper, provider)
    import asyncio
    r = asyncio.run(m.fetch("https://x"))
